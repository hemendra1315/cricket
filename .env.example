# ---------------------------------------------------------------------------
# Client-side environment (Vite exposes ONLY VITE_* to the browser).
# Never put service-role keys or payment gateway secrets in this file —
# those belong in Supabase Edge Function secrets.
# ---------------------------------------------------------------------------

# Supabase project
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# App
VITE_APP_NAME=Cricket Academy Manager
VITE_APP_URL=http://localhost:5173
VITE_DEFAULT_TIMEZONE=Asia/Kolkata
VITE_DEFAULT_LOCALE=en

# Web Push (public VAPID key only; private key lives in Edge Functions)
VITE_VAPID_PUBLIC_KEY=

# Observability / feature flags
VITE_SENTRY_DSN=
VITE_LOG_LEVEL=debug
VITE_ENABLE_DEVTOOLS=true

# ---------------------------------------------------------------------------
# SuperAdmin CLI (server-side only - NEVER expose to browser)
# ---------------------------------------------------------------------------

# Service role key for admin operations (from Supabase Dashboard > Settings > API)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SuperAdmin password hash (bcrypt, generate with: npm run superadmin:hash -- --password "your-password")
SUPERADMIN_PASSWORD_HASH=$2b$12$...

# Encryption key for sensitive data (hex, 64 chars, generate with: npm run superadmin:key)
SUPERADMIN_ENCRYPTION_KEY=your-32-byte-hex-key
